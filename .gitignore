# 依赖与构建产物（release 由 npm run release 现场生成，不入库）
node_modules/
dist/
release/

# 模拟工件（sweep-out 是 sim:sweep / sim:ab 的输出目录，保留目录本身）
sweep-out/
!sweep-out/.gitkeep

# 运行日志与临时产物（.qa 的证据工件 *.txt/*.ts 是文档引用的可复现证据链，保留入库）
*.log
.qa/*.log
.qa/*.pid

# 会话/工作区工具目录（非项目内容）
.workbuddy/
.zcode/
.vscode/
.idea/

# 审计/浏览器实测的临时产物（截图与报告，不入库）
.tmp-shots/

# Python 隔离环境（uv 管理，Python 仅用于一次性辅助脚本，非项目运行时依赖）
.venv/

# 系统杂项
Thumbs.db
.DS_Store
*.tsbuildinfo
.vite/
