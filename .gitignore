# 依赖与构建产物（release 由 npm run release 现场生成，不入库）
node_modules/
dist/
release/

# 模拟工件（sweep-out 是 sim:sweep / sim:ab 的输出目录，保留目录本身）
sweep-out/*
!sweep-out/.gitkeep

# 运行日志与临时产物（.qa 的证据工件 *.txt/*.ts 是文档引用的可复现证据链，保留入库）
*.log
.qa/*.log
.qa/*.pid

# 会话/工作区工具目录（非项目内容）
.workbuddy/
.zcode/
.vscode/
.idea/

# 系统杂项
Thumbs.db
.DS_Store
*.tsbuildinfo
