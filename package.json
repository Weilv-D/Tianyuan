{
  "name": "tianyuan",
  "private": true,
  "version": "1.16.0",
  "type": "module",
  "description": "百战天元 · Tian Yuan — 商业级自走棋",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --allowOnly=false",
    "test:watch": "vitest",
    "qa": "npm run typecheck && npm run check:boundaries && npm test && npm run build:app",
    "sim": "node --no-warnings --import tsx balance/cli.ts matrix",
    "sim:sweep": "node --no-warnings --import tsx balance/cli.ts sweep",
    "sim:match": "node --no-warnings --import tsx balance/cli.ts match",
    "sim:items": "node --no-warnings --import tsx balance/cli.ts items",
    "sim:ab": "node --no-warnings --import tsx balance/cli.ts ab",
    "sim:shop": "node --no-warnings --import tsx balance/cli.ts shop",
    "sim:big": "node --no-warnings --import tsx balance/cli.ts bigorigins",
    "sim:legend": "node --no-warnings --import tsx balance/cli.ts legend",
    "balance": "node --no-warnings --import tsx balance/cli.ts",
    "roster": "node --no-warnings --import tsx balance/cli.ts roster",
    "gold": "node --no-warnings --import tsx balance/cli.ts gold",
    "beast": "node --no-warnings --import tsx balance/cli.ts beast",
    "bench": "node --no-warnings --import tsx balance/cli.ts bench",
    "audit": "node --no-warnings --import tsx balance/cli.ts audit",
    "diag": "node --no-warnings --import tsx balance/cli.ts diag",
    "probe": "node --no-warnings --import tsx balance/cli.ts probe",
    "audit:music": "node scripts/audit-music.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "pngjs": "^7.0.0",
    "subset-font": "^2.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4",
    "fflate": "^0.8.2"
  }
}
