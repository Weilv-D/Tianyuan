{
  "name": "tianyuan",
  "private": true,
  "version": "1.8.2",
  "type": "module",
  "description": "百战天元 · Tian Yuan — 商业级自走棋",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --allowOnly=false",
    "test:watch": "vitest",
    "qa": "npm run typecheck && npm run check:boundaries && npm test && npm run build:app",
    "sim": "tsx scripts/sim.ts",
    "sim:sweep": "tsx scripts/sim-sweep.ts",
    "sim:match": "tsx scripts/sim-match.ts",
    "sim:items": "tsx scripts/sim-items.ts",
    "sim:ab": "tsx scripts/ab-pair.ts",
    "sim:shop": "tsx scripts/sim-shop.ts",
    "sim:big": "tsx scripts/sim-bigorigins.ts",
    "roster": "tsx scripts/roster.ts",
    "gold": "tsx scripts/gold-value.ts",
    "beast": "tsx scripts/check-beast.ts",
    "bench": "tsx scripts/bench.ts",
    "audit": "tsx scripts/audit.ts",
    "diag": "tsx scripts/diag.ts",
    "probe": "tsx scripts/probe.ts",
    "audit:music": "node scripts/audit-music.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "pngjs": "^7.0.0",
    "subset-font": "^2.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4",
    "fflate": "^0.8.2"
  }
}
